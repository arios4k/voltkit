[Desktop Entry]
Name=Voltkit
Comment=OCR, color picker, asset compressor and text expansion in one app
Comment[es]=OCR, selector de color, compresor de archivos y expansión de texto en una sola app
Comment[de]=Texterkennung, Farbwähler, Dateikompressor und Textbausteine in einer App
Comment[fr]=OCR, sélecteur de couleur, compresseur de fichiers et expansion de texte dans une seule application
Comment[zh_CN]=OCR、取色器、文件压缩器和文本扩展，集于一个应用
Exec=voltkit
Icon=io.github.arios4k.Voltkit
Terminal=false
Type=Application
Categories=Utility;GTK;
Keywords=ocr;color;picker;compress;snippet;expander;qr;ruler;hosts;busy;eject;port;permissions;sleep;suspend;battery;paste;convert;json;system;hardware;drivers;specs;firmware;shortcuts;keyboard;keybindings;
Keywords[es]=ocr;texto;color;selector;comprimir;fragmento;qr;regla;hosts;ocupado;expulsar;puerto;permisos;suspender;batería;pegar;convertir;json;sistema;hardware;drivers;firmware;atajos;teclado;
Keywords[de]=ocr;texterkennung;farbe;farbwähler;komprimieren;textbaustein;qr;lineal;hosts;belegt;auswerfen;port;berechtigungen;bereitschaft;akku;einfügen;umwandeln;json;system;hardware;treiber;firmware;tastenkürzel;tastatur;
StartupNotify=true
Actions=ocr;color;

[Desktop Action ocr]
Name=Extract Text from Screen
Name[es]=Extraer texto de la pantalla
Name[de]=Text vom Bildschirm erkennen
Name[fr]=Extraire le texte de l’écran
Name[zh_CN]=提取屏幕上的文字
Exec=voltkit trigger ocr

[Desktop Action color]
Name=Pick a Color from Screen
Name[es]=Tomar un color de la pantalla
Name[de]=Farbe vom Bildschirm aufnehmen
Name[fr]=Choisir une couleur à l’écran
Name[zh_CN]=从屏幕取色
Exec=voltkit trigger color
